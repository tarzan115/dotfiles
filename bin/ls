#!/usr/bin/env bash
# ls -> eza bridge. Forces --color=never so piped/captured output stays plain.
# Falls back to the real ls when a flag's semantics differ (width, dereference,
# quoting, BSD -G color, block-size, -p indicator).
set -u

# Resolve our own path fully: home-manager deploys ~/.local/bin/ls as a
# symlink into the store which then points at this repo file. Resolving only
# one level would land on the store dir (no _lib.sh) and make run_orig re-exec
# the wrapper forever. readlink -f lands on the repo dir, where _lib.sh lives.
_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
source "$_dir/_lib.sh"

has_modern eza || run_orig ls "$@"

color=(--color=never)
for a in "$@"; do
    case "$a" in
        -w | -w* | --width | --width=* | -L | -L* | --dereference | \
        --block-size | --block-size=* | --quoting-style | --quoting-style=* | \
        --full-time | -p | -p* | -Q | -G | -G*)
            run_orig ls "$@"
            ;;
        --color | --color=*) color=() ;; # explicit request -> eza defaults
    esac
done

exec eza "${color[@]}" "${@}"